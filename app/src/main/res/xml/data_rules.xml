<?xml version="1.0" encoding="utf-8"?>
<!-- Tokeny USOS i klucz aplikacji nie trafiają do kopii w chmurze ani do przenoszenia na nowy telefon. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
